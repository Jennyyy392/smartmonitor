# Название сервиса
APP_NAME=SmartMonitor
# Режим отладки
DEBUG=True
# Префикс маршрутов API версии v1
API_V1_PREFIX=/api/v1
# DSN подключения к базе данных (каталог data/ монтируется в контейнер)
DATABASE_URL=sqlite+aiosqlite:///./data/smartmonitor.db
# Интервал фоновой проверки цен (в минутах)
CHECK_INTERVAL_MINUTES=5
# Бэкенд уведомлений: "mock" — имитация, "max" — реальный API MAX
NOTIFICATION_BACKEND=mock
# Параметры API MAX (используются при NOTIFICATION_BACKEND="max")
MAX_API_URL=https://api.max-messenger.ru/v1
MAX_API_TOKEN=
MAX_CHAT_ID=